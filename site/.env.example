# Telefon bilgileri gelene kadar boş bırakın; butonlar otomatik gizlenir.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_E164=

# Kullanıcı analiz çerezlerini kabul edince yüklenir.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# OtoAPI is server-side only. Keep disabled until the local connection test succeeds.
OTOAPI_KEY=
OTOAPI_ENABLED=false

# Yönetim oturumu için yalnızca ilk kurulumda kullanın; DB kullanıcısı açılınca kaldırın.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Sunucu tarafı bildirim sağlayıcıları. Yapılandırılmayan kanal başarılı sayılmaz.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=

# OTP kodlarını geri döndürülemez biçimde özetlemek için en az 32 bayt rastgele sır.
OTP_HASH_SECRET=

# Sunucu tarafında yalnızca AI danışmanı için.
OPENAI_API_KEY=
